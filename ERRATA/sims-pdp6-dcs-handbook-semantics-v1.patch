diff --git a/PDP10/pdp6_dcs.c b/PDP10/pdp6_dcs.c
index 3938d3a..d6e1f9f 100644
--- a/PDP10/pdp6_dcs.c
+++ b/PDP10/pdp6_dcs.c
@@ -178,7 +178,9 @@ t_stat dcs_devio(uint32 dev, uint64 *data) {
 
     case DATAO:
     case DATAO|4:
-         ln = (dev & 4) ? dcs_send_line : dcs_tx_scan;
+         /* PDP-6 Type 630 handbook semantics: DCSA uses the send buffer;
