              lp = &dcs_ldsc[ln];
              if (lp->conn) {
@@ -188,8 +190,12 @@ t_stat dcs_devio(uint32 dev, uint64 *data) {
                 dcs_tx_enable |= (1 << ln);
              }
          }
+         /* Both forms clear the selected receiver flag.  DCSB also
