set -q -n log @SIMH_LOG@
set cpu @CPU_KWORDS@k

; V0.9 root class/ordinal selector: low five console switches.
deposit SW @ROOT_SWITCH@

; PCLK is standard DAIMOS wall-clock hardware.  Enable it explicitly so the
; boot configuration does not depend on simulator compile-time/default flags.
set pclk enabled
set pclk @PCLK_MODE@

; Full DAIMOS hardware configuration.  Keep every implemented PDP-6 device
; online so MINIT loads the corresponding resident driver package.
set cr enabled
set cp enabled
set ptr enabled
set ptp enabled
set lpt enabled
set dsk enabled
set dp enabled
set dr enabled
set dr0 enabled
set dr0 writeenabled
set dr1 enabled
set dr1 writeenabled
set dr2 enabled
set dr2 writeenabled
set dr3 enabled
set dr3 writeenabled
set dct enabled
set dtc dct=04
set dtc enabled
set dtc0 enabled
set dtc1 enabled
set dtc2 enabled
; Type 516 MTC uses DCT channel 0 in the simulator and DAIMOS driver model.
; The boot/runtime media format is seven-track binary tape.
set mtc dct=0
set mtc enabled
set mtc0 enabled
set mtc0 7t
set mtc1 enabled
set mtc1 7t
set dcs enabled
set dcs lines=8
set ge enabled
set slave enabled
set dpy enabled
set wcnsls cscope
set wcnsls enabled
set ocnsls enabled

; Bootstrap read-in loop.
deposit 020 710600000060
deposit 021 710740000010
deposit 022 254000000021
deposit 023 710440000026
deposit 024 710740000010
deposit 025 254000000024
deposit 026 000000000000
deposit 027 254000000021

attach -q ptr @STAGE1_TAPE@
attach -q -n ptp @PTP_OUTPUT@
attach -q -n cp @CP_OUTPUT@
attach -q -n lpt @LPT_OUTPUT@
deposit ptr time 1
attach -q dsk0 @DISK_IMAGE@

; Simulator serial transports for the first multi-terminal userspace login.
attach -q dcs0 @DCS0_PORT@
attach -q ge0 @GE0_PORT@

; Writable blank media for interactive DTFS/storage testing.  The files are
; persistent until make clean removes the build tree.
attach -q dtc0 @DTC0_IMAGE@
attach -q dtc1 @DTC1_IMAGE@
attach -q dtc2 @DTC2_IMAGE@
attach -q mtc0 @MTC0_IMAGE@
attach -q mtc1 @MTC1_IMAGE@
attach -q dr0 @DR0_IMAGE@
attach -q dr1 @DR1_IMAGE@
attach -q dr2 @DR2_IMAGE@
attach -q dr3 @DR3_IMAGE@

@BOOT_COMMANDS@
exit
