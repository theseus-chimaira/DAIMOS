# Generated build output
build/

# Compiler and linker output
*.o
*.a
*.so
*.dxr
*.rim
*.pt
*.tap
*.dt

# Test and emulator output
*.log
*.simh.log

# Temporary files
*~
*.tmp
*.swp
*.swo
.core
/core

# Local picture inputs converted by img2dpic.  The directory itself is kept by
# pictures/.gitignore; user picture payloads never belong in the repository.
/pictures/*
!/pictures/.gitignore
