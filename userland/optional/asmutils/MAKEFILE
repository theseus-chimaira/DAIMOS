# NATIVE DAIMOS MAKEFILE FOR OPTIONAL PDP-6 ASSEMBLER UTILITIES.

DAS ?= DAS
DASFLAGS ?= -B -S
PREFIX ?= /OPTION/BASE
EXEC = $(PREFIX)/EXEC
SOURCE = $(PREFIX)/SOURCE/ASMUTILS

PROGRAMS = ARGS.DXR ASCII2SIX.DXR BENCH.DXR CPUSPEED.DXR CRC.DXR DIS.DXR \
 DXRINFO.DXR ECHO.DXR FACTOR.DXR FALSE.DXR MKDIR.DXR MV.DXR OD.DXR \
 PRIME.DXR RAND.DXR REV.DXR RM.DXR RMDIR.DXR SIX2ASCII.DXR SLEEP.DXR \
 SORT.DXR SUM.DXR TOUCH.DXR TR.DXR TRUE.DXR UNIQ.DXR YES.DXR

.PHONY: ALL INSTALL INSTALL-SOURCE CLEAN

ALL: $(PROGRAMS)

.S.DXR:
> $(DAS) $(DASFLAGS) -O $@ $<

INSTALL: ALL
> CP ARGS.DXR $(EXEC)/ARGS
> CP ASCII2SIX.DXR $(EXEC)/ASCII2SIX
> CP BENCH.DXR $(EXEC)/BENCH
> CP CPUSPEED.DXR $(EXEC)/CPUSPEED
> CP CRC.DXR $(EXEC)/CRC
> CP DIS.DXR $(EXEC)/DIS
> CP DXRINFO.DXR $(EXEC)/DXRINFO
> CP ECHO.DXR $(EXEC)/ECHO
> CP FACTOR.DXR $(EXEC)/FACTOR
> CP FALSE.DXR $(EXEC)/FALSE
> CP MKDIR.DXR $(EXEC)/MKDIR
> CP MV.DXR $(EXEC)/MV
> CP OD.DXR $(EXEC)/OD
> CP PRIME.DXR $(EXEC)/PRIME
> CP RAND.DXR $(EXEC)/RAND
> CP REV.DXR $(EXEC)/REV
> CP RM.DXR $(EXEC)/RM
> CP RMDIR.DXR $(EXEC)/RMDIR
> CP SIX2ASCII.DXR $(EXEC)/SIX2ASCII
> CP SLEEP.DXR $(EXEC)/SLEEP
> CP SORT.DXR $(EXEC)/SORT
> CP SUM.DXR $(EXEC)/SUM
> CP TOUCH.DXR $(EXEC)/TOUCH
> CP TR.DXR $(EXEC)/TR
> CP TRUE.DXR $(EXEC)/TRUE
> CP UNIQ.DXR $(EXEC)/UNIQ
> CP YES.DXR $(EXEC)/YES

INSTALL-SOURCE:
> -MKDIR $(SOURCE)
> CP *.S $(SOURCE)/
> CP MAKEFILE $(SOURCE)/MAKEFILE

CLEAN:
> RM -F $(PROGRAMS)
