# OPTIONAL DAIMOS PDP-6 ASSEMBLER UTILITIES.
#
# THIS IS THE SINGLE CANONICAL HOST/NATIVE MAKEFILE.  THE BOOT BUILD CONVERTS
# IT TO S6REC BY UPPERCASING TEXT, CHANGING A LEADING RECIPE TAB TO '>', AND
# CHANGING DAS INPUT MODE -A (HOST ASCII SOURCE) TO -S (NATIVE S6REC SOURCE).

DAS = das
DASFLAGS = -B
CP = cp
RM = rm
MKDIR = mkdir
DESTDIR =
PREFIX = /OPTION/BASE
EXEC = $(DESTDIR)$(PREFIX)/EXEC
SOURCE = $(DESTDIR)$(PREFIX)/SOURCE/ASMUTILS

.PHONY: all install install-source clean check
.SUFFIXES: .S .DXR

all: ARGS.DXR ASCII2SIX.DXR BENCH.DXR CPUSPEED.DXR CRC.DXR DIS.DXR DXRINFO.DXR
all: ECHO.DXR FACTOR.DXR FALSE.DXR MKDIR.DXR MV.DXR OD.DXR PRIME.DXR
all: RAND.DXR REV.DXR RM.DXR RMDIR.DXR SIX2ASCII.DXR SLEEP.DXR SORT.DXR
all: SUM.DXR TOUCH.DXR TR.DXR TRUE.DXR UNIQ.DXR YES.DXR

# EVERY PROGRAM IS A SEPARATE EXECUTABLE. BASE.S AND S6REC.S ARE SOURCE
# INCLUDES SHARED AT ASSEMBLY TIME ONLY; THERE IS NO MULTICALL RUNTIME IMAGE.
ARGS.DXR: ARGS.S BASE.S S6REC.S
ASCII2SIX.DXR: ASCII2SIX.S BASE.S S6REC.S
BENCH.DXR: BENCH.S BASE.S S6REC.S
CPUSPEED.DXR: CPUSPEED.S BASE.S S6REC.S
CRC.DXR: CRC.S BASE.S S6REC.S
DIS.DXR: DIS.S BASE.S S6REC.S
DXRINFO.DXR: DXRINFO.S BASE.S S6REC.S
ECHO.DXR: ECHO.S BASE.S S6REC.S
FACTOR.DXR: FACTOR.S BASE.S S6REC.S
FALSE.DXR: FALSE.S BASE.S S6REC.S
MKDIR.DXR: MKDIR.S BASE.S S6REC.S
MV.DXR: MV.S BASE.S S6REC.S
OD.DXR: OD.S BASE.S S6REC.S
PRIME.DXR: PRIME.S BASE.S S6REC.S
RAND.DXR: RAND.S BASE.S S6REC.S
REV.DXR: REV.S BASE.S S6REC.S
RM.DXR: RM.S BASE.S S6REC.S
RMDIR.DXR: RMDIR.S BASE.S S6REC.S
SIX2ASCII.DXR: SIX2ASCII.S BASE.S S6REC.S
SLEEP.DXR: SLEEP.S BASE.S S6REC.S
SORT.DXR: SORT.S BASE.S S6REC.S
SUM.DXR: SUM.S BASE.S S6REC.S
TOUCH.DXR: TOUCH.S BASE.S S6REC.S
TR.DXR: TR.S BASE.S S6REC.S
TRUE.DXR: TRUE.S BASE.S S6REC.S
UNIQ.DXR: UNIQ.S BASE.S S6REC.S
YES.DXR: YES.S BASE.S S6REC.S

.S.DXR:
	$(DAS) $(DASFLAGS) -O $@ $<

install: all
	-$(MKDIR) $(EXEC)
	$(CP) ARGS.DXR $(EXEC)/ARGS
	$(CP) ASCII2SIX.DXR $(EXEC)/ASCII2SIX
	$(CP) BENCH.DXR $(EXEC)/BENCH
	$(CP) CPUSPEED.DXR $(EXEC)/CPUSPEED
	$(CP) CRC.DXR $(EXEC)/CRC
	$(CP) DIS.DXR $(EXEC)/DIS
	$(CP) DXRINFO.DXR $(EXEC)/DXRINFO
	$(CP) ECHO.DXR $(EXEC)/ECHO
	$(CP) FACTOR.DXR $(EXEC)/FACTOR
	$(CP) FALSE.DXR $(EXEC)/FALSE
	$(CP) MKDIR.DXR $(EXEC)/MKDIR
	$(CP) MV.DXR $(EXEC)/MV
	$(CP) OD.DXR $(EXEC)/OD
	$(CP) PRIME.DXR $(EXEC)/PRIME
	$(CP) RAND.DXR $(EXEC)/RAND
	$(CP) REV.DXR $(EXEC)/REV
	$(CP) RM.DXR $(EXEC)/RM
	$(CP) RMDIR.DXR $(EXEC)/RMDIR
	$(CP) SIX2ASCII.DXR $(EXEC)/SIX2ASCII
	$(CP) SLEEP.DXR $(EXEC)/SLEEP
	$(CP) SORT.DXR $(EXEC)/SORT
	$(CP) SUM.DXR $(EXEC)/SUM
	$(CP) TOUCH.DXR $(EXEC)/TOUCH
	$(CP) TR.DXR $(EXEC)/TR
	$(CP) TRUE.DXR $(EXEC)/TRUE
	$(CP) UNIQ.DXR $(EXEC)/UNIQ
	$(CP) YES.DXR $(EXEC)/YES

install-source:
	-$(MKDIR) $(SOURCE)
	$(CP) ARGS.S $(SOURCE)/ARGS.S
	$(CP) ASCII2SIX.S $(SOURCE)/ASCII2SIX.S
	$(CP) BASE.S $(SOURCE)/BASE.S
	$(CP) BENCH.S $(SOURCE)/BENCH.S
	$(CP) CPUSPEED.S $(SOURCE)/CPUSPEED.S
	$(CP) CRC.S $(SOURCE)/CRC.S
	$(CP) DIS.S $(SOURCE)/DIS.S
	$(CP) DXRINFO.S $(SOURCE)/DXRINFO.S
	$(CP) ECHO.S $(SOURCE)/ECHO.S
	$(CP) FACTOR.S $(SOURCE)/FACTOR.S
	$(CP) FALSE.S $(SOURCE)/FALSE.S
	$(CP) MKDIR.S $(SOURCE)/MKDIR.S
	$(CP) MV.S $(SOURCE)/MV.S
	$(CP) OD.S $(SOURCE)/OD.S
	$(CP) PRIME.S $(SOURCE)/PRIME.S
	$(CP) RAND.S $(SOURCE)/RAND.S
	$(CP) REV.S $(SOURCE)/REV.S
	$(CP) RM.S $(SOURCE)/RM.S
	$(CP) RMDIR.S $(SOURCE)/RMDIR.S
	$(CP) S6REC.S $(SOURCE)/S6REC.S
	$(CP) SIX2ASCII.S $(SOURCE)/SIX2ASCII.S
	$(CP) SLEEP.S $(SOURCE)/SLEEP.S
	$(CP) SORT.S $(SOURCE)/SORT.S
	$(CP) SUM.S $(SOURCE)/SUM.S
	$(CP) TOUCH.S $(SOURCE)/TOUCH.S
	$(CP) TR.S $(SOURCE)/TR.S
	$(CP) TRUE.S $(SOURCE)/TRUE.S
	$(CP) UNIQ.S $(SOURCE)/UNIQ.S
	$(CP) YES.S $(SOURCE)/YES.S
	$(CP) Makefile $(SOURCE)/MAKEFILE

check: all

clean:
	-$(RM) ARGS.DXR ASCII2SIX.DXR BENCH.DXR CPUSPEED.DXR CRC.DXR DIS.DXR DXRINFO.DXR
	-$(RM) ECHO.DXR FACTOR.DXR FALSE.DXR MKDIR.DXR MV.DXR OD.DXR PRIME.DXR
	-$(RM) RAND.DXR REV.DXR RM.DXR RMDIR.DXR SIX2ASCII.DXR SLEEP.DXR SORT.DXR
	-$(RM) SUM.DXR TOUCH.DXR TR.DXR TRUE.DXR UNIQ.DXR YES.DXR
