# OPTIONAL DAIMOS PDP-6 ASSEMBLER UTILITIES.
#
# THIS IS THE SINGLE CANONICAL HOST/NATIVE MAKEFILE.  THE BOOT BUILD CONVERTS
# IT TO S6REC BY UPPERCASING TEXT AND CHANGING A LEADING RECIPE TAB TO '>'.
# DAS AUTO-DETECTS HOST ASCII VERSUS NATIVE S6REC SOURCE.

DAS = das
DASFLAGS = -B
CP = cp
RM = rm
MKDIR = mkdir
DESTDIR =
PREFIX = /OPTION/BASE
EXEC = $(DESTDIR)$(PREFIX)/EXEC
SOURCE = $(DESTDIR)$(PREFIX)/SOURCE/ASMUTILS

.PHONY: all install install-source clean check
.SUFFIXES: .S

all: ARGS ASCII2SIX BENCH CPUSPEED CRC DIS DXRINFO ECHO FACTOR FALSE MKDIR MV
all: OD PRIME RAND REV RMDIR SIX2ASCII SLEEP SORT SUM TOUCH TR TRUE UNIQ YES

# EVERY PROGRAM IS A SEPARATE EXECUTABLE. BASE.S AND S6REC.S ARE SOURCE
# INCLUDES SHARED AT ASSEMBLY TIME ONLY; THERE IS NO MULTICALL RUNTIME IMAGE.
ARGS: ARGS.S BASE.S S6REC.S
ASCII2SIX: ASCII2SIX.S BASE.S S6REC.S
BENCH: BENCH.S BASE.S S6REC.S
CPUSPEED: CPUSPEED.S BASE.S S6REC.S
CRC: CRC.S BASE.S S6REC.S
DIS: DIS.S BASE.S S6REC.S
DXRINFO: DXRINFO.S BASE.S S6REC.S
ECHO: ECHO.S BASE.S S6REC.S
FACTOR: FACTOR.S BASE.S S6REC.S
FALSE: FALSE.S BASE.S S6REC.S
MKDIR: MKDIR.S BASE.S S6REC.S
MV: MV.S BASE.S S6REC.S
OD: OD.S BASE.S S6REC.S
PRIME: PRIME.S BASE.S S6REC.S
RAND: RAND.S BASE.S S6REC.S
REV: REV.S BASE.S S6REC.S
RMDIR: RMDIR.S BASE.S S6REC.S
SIX2ASCII: SIX2ASCII.S BASE.S S6REC.S
SLEEP: SLEEP.S BASE.S S6REC.S
SORT: SORT.S BASE.S S6REC.S
SUM: SUM.S BASE.S S6REC.S
TOUCH: TOUCH.S BASE.S S6REC.S
TR: TR.S BASE.S S6REC.S
TRUE: TRUE.S BASE.S S6REC.S
UNIQ: UNIQ.S BASE.S S6REC.S
YES: YES.S BASE.S S6REC.S

.S:
	$(DAS) $(DASFLAGS) -O $@ $<

install: all
	-$(MKDIR) $(EXEC)
	# Remove the obsolete assembler RM, which otherwise shadows system RM.
	-$(RM) $(EXEC)/RM
	$(CP) ARGS $(EXEC)/ARGS
	$(CP) ASCII2SIX $(EXEC)/ASCII2SIX
	$(CP) BENCH $(EXEC)/BENCH
	$(CP) CPUSPEED $(EXEC)/CPUSPEED
	$(CP) CRC $(EXEC)/CRC
	$(CP) DIS $(EXEC)/DIS
	$(CP) DXRINFO $(EXEC)/DXRINFO
	$(CP) ECHO $(EXEC)/ECHO
	$(CP) FACTOR $(EXEC)/FACTOR
	$(CP) FALSE $(EXEC)/FALSE
	$(CP) MKDIR $(EXEC)/MKDIR
	$(CP) MV $(EXEC)/MV
	$(CP) OD $(EXEC)/OD
	$(CP) PRIME $(EXEC)/PRIME
	$(CP) RAND $(EXEC)/RAND
	$(CP) REV $(EXEC)/REV
	$(CP) RMDIR $(EXEC)/RMDIR
	$(CP) SIX2ASCII $(EXEC)/SIX2ASCII
	$(CP) SLEEP $(EXEC)/SLEEP
	$(CP) SORT $(EXEC)/SORT
	$(CP) SUM $(EXEC)/SUM
	$(CP) TOUCH $(EXEC)/TOUCH
	$(CP) TR $(EXEC)/TR
	$(CP) TRUE $(EXEC)/TRUE
	$(CP) UNIQ $(EXEC)/UNIQ
	$(CP) YES $(EXEC)/YES

install-source:
	-$(MKDIR) $(SOURCE)
	$(CP) ARGS.S $(SOURCE)/ARGS.S
	$(CP) ASCII2SIX.S $(SOURCE)/ASCII2SIX.S
	$(CP) BASE.S $(SOURCE)/BASE.S
	$(CP) BENCH.S $(SOURCE)/BENCH.S
	$(CP) CPUSPEED.S $(SOURCE)/CPUSPEED.S
	$(CP) CRC.S $(SOURCE)/CRC.S
	$(CP) DIS.S $(SOURCE)/DIS.S
	$(CP) DXRINFO.S $(SOURCE)/DXRINFO.S
	$(CP) ECHO.S $(SOURCE)/ECHO.S
	$(CP) FACTOR.S $(SOURCE)/FACTOR.S
	$(CP) FALSE.S $(SOURCE)/FALSE.S
	$(CP) MKDIR.S $(SOURCE)/MKDIR.S
	$(CP) MV.S $(SOURCE)/MV.S
	$(CP) OD.S $(SOURCE)/OD.S
	$(CP) PRIME.S $(SOURCE)/PRIME.S
	$(CP) RAND.S $(SOURCE)/RAND.S
	$(CP) REV.S $(SOURCE)/REV.S
	$(CP) RMDIR.S $(SOURCE)/RMDIR.S
	$(CP) S6REC.S $(SOURCE)/S6REC.S
	$(CP) SIX2ASCII.S $(SOURCE)/SIX2ASCII.S
	$(CP) SLEEP.S $(SOURCE)/SLEEP.S
	$(CP) SORT.S $(SOURCE)/SORT.S
	$(CP) SUM.S $(SOURCE)/SUM.S
	$(CP) TOUCH.S $(SOURCE)/TOUCH.S
	$(CP) TR.S $(SOURCE)/TR.S
	$(CP) TRUE.S $(SOURCE)/TRUE.S
	$(CP) UNIQ.S $(SOURCE)/UNIQ.S
	$(CP) YES.S $(SOURCE)/YES.S
	$(CP) Makefile $(SOURCE)/MAKEFILE

check: all

clean:
	-$(RM) ARGS ASCII2SIX BENCH CPUSPEED CRC DIS DXRINFO ECHO FACTOR FALSE MKDIR MV
	-$(RM) OD PRIME RAND REV RMDIR SIX2ASCII SLEEP SORT SUM TOUCH TR TRUE UNIQ YES
