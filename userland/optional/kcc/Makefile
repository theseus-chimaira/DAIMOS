# NATIVE DAIMOS KCC SOURCE WORKSPACE.
# THE BOOT BUILDER UPPERCASES THIS FILE AND CONVERTS TABS TO '>' RECIPES.
# SELF-REBUILD REQUIRES MORE DRIVER/PROFILE WORK; DO NOT CLAIM IT WORKS YET.
KCC = /OPTION/BASE/EXEC/KCC
DAS = /OPTION/BASE/EXEC/DAS
.PHONY: ALL HELP
.SUFFIXES: .C .S .DOBJ
ALL: HELP
HELP:
	ECHO USE MAKE NAME.S TO COMPILE NAME.C
	ECHO USE MAKE NAME.DOBJ TO ASSEMBLE NAME.S
	ECHO FULL NATIVE KCC SELF-REBUILD NOT YET IMPLEMENTED
.C.S:
	$(KCC) -S -O $@ $<
.S.DOBJ:
	$(DAS) -F -C -O $@ $<
