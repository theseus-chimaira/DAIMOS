# NATIVE DAIMOS KCC SOURCE WORKSPACE.
# THE BOOT BUILDER UPPERCASES THIS FILE AND CONVERTS TABS TO '>' RECIPES.
# THE FULL PHASE BUILD REQUIRES KCC DRIVER -D/-I SUPPORT AND NATIVE LIBRARIES.
KCC = /OPTION/BASE/EXEC/KCC
DAS = /OPTION/BASE/EXEC/DAS
DLINK = /OPTION/BASE/EXEC/DLINK
CP = CP
MKDIR = MKDIR
PREFIX = /OPTION/BASE
EXEC = $(PREFIX)/EXEC
LIBEXEC = $(PREFIX)/LIBEXEC/KCC
.PHONY: ALL HELP INSTALL CLEAN
.SUFFIXES: .C .S .DOBJ
ALL:
	ECHO ERROR NATIVE FULL KCC REBUILD REQUIRES PHASE PROFILE FLAGS AND LINK LIBRARIES
	FALSE
HELP:
	ECHO USE MAKE NAME.S TO COMPILE NAME.C
	ECHO USE MAKE NAME.DOBJ TO ASSEMBLE NAME.S
	ECHO FULL NATIVE KCC SELF-REBUILD NOT YET IMPLEMENTED
INSTALL: ALL
CLEAN:
	ECHO CLEAN OF BUILT KCC PHASE OBJECTS REQUIRES NATIVE PHASE BUILD SUPPORT
.C.S:
	$(KCC) -S -O $@ $<
.S.DOBJ:
	$(DAS) -F -C -O $@ $<
